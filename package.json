{
  "name": "researchgit",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "check": "biome check src/ scripts/",
    "format": "biome format --write src/ scripts/",
    "lint": "biome lint src/ scripts/",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "migrate-neo4j": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-neo4j.ts",
    "seed-neo4j": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-neo4j.ts",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.0",
    "neo4j-driver": "^5.27.0",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^4.95.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "lefthook": "^1.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
